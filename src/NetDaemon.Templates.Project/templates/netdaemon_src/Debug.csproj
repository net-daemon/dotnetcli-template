<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Debug</RootNamespace>
 </PropertyGroup>
  <ItemGroup>
    <None Update="$(MSBuildProjectDir)appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="$(MSBuildProjectDir)appsettings.Development.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetDaemon.AppModel" Version="26.3.0" />
    <PackageReference Include="NetDaemon.AppModel.SourceDeployedApps" Version="26.3.0" />
    <PackageReference Include="NetDaemon.Runtime" Version="26.3.0" />
    <PackageReference Include="NetDaemon.HassModel" Version="26.3.0" />
    <PackageReference Include="NetDaemon.Client" Version="26.3.0" />
    <PackageReference Include="NetDaemon.Extensions.Scheduling" Version="26.3.0" />
    <PackageReference Include="NetDaemon.Extensions.Logging" Version="26.3.0" />
    <PackageReference Include="NetDaemon.Extensions.Tts" Version="26.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include=".devcontainer\devcontainer.json" />
    <Content Include=".vscode\launch.json" />
    <Content Include=".vscode\tasks.json" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="SrcDeploy" />
  </ItemGroup>


</Project>
